{
  "name": "typelatch",
  "version": "0.1.1",
  "description": "Local API evidence for TypeScript coding agents",
  "type": "module",
  "bin": {
    "typelatch": "dist/cli.js",
    "typelatch-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/assets.mjs",
    "site:build": "node scripts/site.mjs",
    "site:check": "node --test scripts/site.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "verify": "npm run check && npm test",
    "prove:support": "npm run build && npm ci --prefix examples/support --ignore-scripts && node scripts/support.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "release:check": "npm run verify && node scripts/packagecheck.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.3",
    "tar": "7.5.22",
    "typescript": "6.0.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "effect": "3.22.1",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eDimka/typelatch.git"
  },
  "homepage": "https://github.com/eDimka/typelatch#readme",
  "bugs": {
    "url": "https://github.com/eDimka/typelatch/issues"
  },
  "keywords": [
    "typescript",
    "mcp",
    "agents",
    "api",
    "verification",
    "sqlite"
  ]
}
