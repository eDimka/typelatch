{
  "schemaVersion": 2,
  "target": {
    "package": "exact package name",
    "version": "exact workspace version",
    "exports": [
      "public export name"
    ]
  },
  "direct": [
    {
      "file": "repository relative configured production source",
      "package": "owning package name",
      "symbol": "original public export name",
      "role": "runtime | type-only | reexport",
      "evidence": {
        "startLine": 1,
        "endLine": 1,
        "quote": "exact source covering the reference token"
      }
    }
  ],
  "packageDependents": [
    {
      "package": "workspace package name, optionally followed by @exact-version",
