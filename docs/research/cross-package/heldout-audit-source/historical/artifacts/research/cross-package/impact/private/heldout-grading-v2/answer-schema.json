      ]
    }
  ],
  "validationTargets": [
    {
      "package": "owning package name or <root>",
      "script": "actual scripts object key",
      "evidence": {
        "file": "package.json path",
        "startLine": 1,
        "endLine": 1,
        "quote": "exact scripts property name and command value"
      }
    }
  ],
  "exclusions": [
    {
      "file": "repository relative path",
      "symbol": "declared/imported local name, literal target name, or * for configuration exclusions",
      "reason": "different-symbol | string-or-comment-only | outside-source-scope",
      "evidence": {
        "startLine": 1,
        "endLine": 1,
        "quote": "exact declaration/import binding, literal/comment or excluded source"
      }
    }
  ],
  "uncertainties": [
    {
      "code": "external-consumers",
