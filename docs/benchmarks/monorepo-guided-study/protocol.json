    "typelatchArchiveBinding": {
      "archiveSha256": "8dc79e045f0acf67cc25a6090d62e6b2aecc424a1749b1c4843a10868a7b9d3f",
      "archiveIntegrity": "sha512-i2KEa8RvfUPrsMBgu817HLEJ5iielLHozl1WT3gK7hz6k+7BWrQTR8XSxbGxTQgDh721ELMFPukFBfuAGi+IDg==",
      "packageFileCount": 138,
      "packageTreeSha256": "7da569eaf51fbfa2b4880cf316e9160a0b1a1a90b3537336bb41718713e088b1",
      "sourceCommit": "285aca16a064b9f3903f360d1c4bf31c7fa2a611",
      "name": "typelatch",
      "version": "0.4.0"
    },
    "treatment": "Same conditional first-investigation instruction in all arms. Native uses native retrieval; packet and Serena must attempt one task-relevant provider retrieval before choosing freely. Startup instructions do not count as retrieval. No forced API inspection or provider validation. Independent public-action review is required before a qualified win.",
    "timing": "Fresh corpus copies and independent grading excluded. Provider-specific setup is charged once, plus agent wall time including MCP startup, query work and native validation. Teardown measured separately. No prepared package index is required for Typelatch; any indexing it performs during use is already inside agent time.",
    "selection": "Separate secondary instructed-use study after the availability design showed zero provider adoption in its first task. The same two qualified tasks, unchanged candidate runtime and controls are retained. All prior studies stay separate. No outcomes are replaced or pooled. Two repeats use ABBA task order and reverse arm order per task; with three arms ordinal positions cannot balance exactly across four blocks.",
    "failurePolicy": "Persist preparation before work and run before launch. Preserve every attempt. Failed or interrupted preparation cannot be retried; interrupted or incomplete launches remain visible. Resume only a completed prefix. No replacements.",
    "evidencePolicy": "Private raw JSONL retained. Only completed public actions, source changes, independent test results, usage and timestamp metadata are eligible for export. No reasoning or assistant message bodies.",
    "limits": [
      "Instructed use cannot establish automatic adoption or an availability benefit.",
      "This follow-up was proposed after observing zero adoption in initial availability runs; it is a separate research question.",
      "One task tests a real installed-API migration and one tests source workflow in the same pnpm snapshot. This narrow sample does not establish general API or monorepo superiority.",
      "A two-task sample with two repeats is not universal superiority or a statistical confidence bound.",
      "The public upstream repairs may occur in model training data.",
      "No immutable served model snapshot or sampling seed is available.",
      "OS file caches and provider prompt caching may be warm; cached tokens remain included.",
      "Fixture and prompt boundaries are procedural; no OS isolation claim is made."
    ]
  }
